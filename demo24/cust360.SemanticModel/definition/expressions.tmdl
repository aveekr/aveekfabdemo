expression 'DirectQuery to AS - customer360' =
		let
		    Source = AnalysisServices.Database("powerbi://api.powerbi.com/v1.0/myorg/demoai24", "customer360"),
		    Cubes = Table.Combine(Source[Data]),
		    Cube = Cubes{[Id="Model", Kind="Cube"]}[Data]
		in
		    Cube
	lineageTag: 4beb949b-0a7c-4394-91e9-e95c95163850

	annotation PBI_IncludeFutureArtifacts = True

